/", "desc": "人民日报社主管主办的人文历史半月刊", "cat": "人文历史", "fav": "https://icons.duckduckgo.com/ip3/gjrwls.com.ico"}, {"name": "中国国家地理网", "url": "https://www.dili360.com/", "desc": "《中国国家地理》官方站点", "cat": "人文历史", "fav": "https://icons.duckduckgo.com/ip3/dili360.com.ico"}, {"name": "哈佛商业评论中文版", "url": "https://www.hbrchina.org/", "desc": "全球商业管理思想的中文阵地", "cat": "金融财经", "fav": "https://icons.duckduckgo.com/ip3/hbrchina.org.ico"}, {"name": "商业周刊中文版", "url": "https://www.bbwc.cn/", "desc": "彭博商业周刊中文版·国际视野", "cat": "金融财经", "fav": "https://icons.duckduckgo.com/ip3/bbwc.cn.ico"}, {"name": "读者", "url": "https://www.duzhe.com/", "desc": "甘肃人民出版社《读者》官网", "cat": "人文历史", "fav": "https://icons.duckduckgo.com/ip3/duzhe.com.ico"}, {"name": "青年文摘", "url": "https://www.qnwz.cn/", "desc": "中国青年出版总社旗下文摘月刊", "cat": "人文历史", "fav": "https://icons.duckduckgo.com/ip3/qnwz.cn.ico"}, {"name": "半月谈", "url": "https://www.banyuetan.org/", "desc": "中宣部委托新华社主办的时政刊物", "cat": "新闻时政", "fav": "https://icons.duckduckgo.com/ip3/banyuetan.org.ico"}, {"name": "人物", "url": "https://www.renwugc.com/", "desc": "报道时代人物的新闻周刊", "cat": "新闻时政", "fav": "https://icons.duckduckgo.com/ip3/renwugc.com.ico"}, {"name": "New Scientist", "url": "https://www.newscientist.com/", "desc": "国际科学新闻与科技前沿", "cat": "学术文献", "fav": "https://icons.duckduckgo.com/ip3/newscientist.com.ico"}, {"name": "南方人物周刊", "url": "https://www.nfpeople.com/", "desc": "南方报业旗下的人物类新闻周刊", "cat": "新闻时政", "fav": "https://icons.duckduckgo.com/ip3/nfpeople.com.ico"}], "album": [{"src": "", "caption": "第一张照片", "date": "2026-10-26"}, {"src": "", "caption": "某个下午", "date": "2026-10-20"}, {"src": "", "caption": "路边", "date": "2026-10-12"}, {"src": "", "caption": "窗外", "date": "2026-10-01"}, {"src": "", "caption": "旧物", "date": "2026-09-20"}, {"src": "", "caption": "雨后", "date": "2026-09-08"}], "timeline": [{"date": "2020-01-15", "title": "从零把站搭起来", "desc": "没用框架，也没引依赖，HTML、CSS、JS 全是手写的，整站静态。\n图的就是简单，国内打开也快。", "tags": ["起点"]}, {"date": "2020-02-15", "title": "把站点从本地推到了线上", "desc": "本地能跑了之后，开始琢磨怎么让它真正上线，服务器和部署的事一点点摸清。", "tags": ["上线"]}, {"date": "2020-03-15", "title": "配色换成了淡紫", "desc": "原来是黑白极简，看久了发闷。换成一整套偏紫的冷色，暗色模式一起做了。", "tags": ["视觉"]}, {"date": "2020-05-15", "title": "定下三栏的骨架", "desc": "首页、文章、关于统一成左中右三栏：左边个人信息，中间正文，右边动态和日历。\n一开始不习惯，用了两天觉得挺好，信息一眼都在。", "tags": ["改版"]}, {"date": "2020-06-15", "title": "加了全文搜索和欢迎首屏", "desc": "文章多了不好找，做了个全文搜索，Ctrl+K 就能叫出来。\n打开站点先是一屏背景图，中间一句话用打字机一个字一个字敲出来，我自己看着挺喜欢。", "tags": ["功能"]}, {"date": "2020-08-15", "title": "主页的毛玻璃去掉了", "desc": "之前压在背景上那层毛玻璃，好看是好看，但有点脏。\n干脆去掉，背景原图直接露出来，字加了点柔和阴影，实在看不清的地方把整块压暗两成。", "tags": ["视觉"]}, {"date": "2020-10-15", "title": "补了动态、相册和网址导航", "desc": "光有文章太单薄，又添了三种：随手记的动态、一些照片、一个常用网址的合集。\n时间线只记站点本身改了什么，不跟文章混在一起，翻起来清楚。", "tags": ["内容"]}, {"date": "2020-11-15", "title": "顶栏重新排了一下", "desc": "改成三段式居中，图标配文字，鼠标放上去有个小提示。\n用得不多的入口收进「更多」里，顶栏一下子清爽了。", "tags": ["导航"]}, {"date": "2021-01-15", "title": "加了背景音乐和歌词", "desc": "换了首背景音乐，把 LRC 歌词内联进去，点开能看，播到哪句哪句亮。", "tags": ["音乐"]}, {"date": "2021-03-15", "title": "改成单页切换，歌不再断", "desc": "以前每点一个导航，整页刷新，歌就断了，听一半没了很扫兴。\n改成单页路由，只换内容区，播放器不动，背景音乐能一直放。\n进度条加了一块透明的可点区域，点一下、拖着走都行，时长也正常显示了。", "tags": ["音乐", "体验"]}, {"date": "2021-04-15", "title": "文章支持折叠块了", "desc": "长文里那些「想看再看」的参考资料、原段落，收进折叠块，默认合上。正文一口气读完，细节留着不挡路。", "tags": []}, {"date": "2021-05-15", "title": "日历挪进右栏，独立页面删了", "desc": "原来单独一个日历页，进去的人没几个，干脆删掉，旧链接指回首页。\n右栏这个小日历顺手补了农历、节气和节日，发过文章的日子会标出来，能翻月份，也能一键回到这个月。\n日程和记事没做——试过，自己用不上，还占地方，就砍了。", "tags": ["视觉", "改版"]}, {"date": "2021-07-15", "title": "文章页右边加了个目录", "desc": "长文章翻起来费劲，就从正文的小标题自动生成一份目录挂在右栏。\n点一下跳过去，滚到哪一节，目录里对应的那行就亮起来。", "tags": ["阅读", "导航"]}, {"date": "2021-08-15", "title": "手机上三栏叠成一列", "desc": "左中右在窄屏互相挤，改成上下排，个人信息收到顶部折叠里。桌面和手机是两套布局，不是硬缩。", "tags": []}, {"date": "2021-09-15", "title": "欢迎页改成一直待在顶上", "desc": "之前欢迎页只在第一次进站时出现，看完就没了，想再看一眼还得刷新。\n现在它就在页面最上面，随便翻到哪，往上滚都能回去。\n切页面的时候会自动落到正文开头，免得每次都先划过大屏。\n刷新和直接点文章链接的落点分开处理，不然打开一篇文还得先看欢迎页。", "tags": ["体验", "优化"]}, {"date": "2021-10-15", "title": "播放器做成了唱片机的样子", "desc": "封面放大成一个带白边的圆盘，播放的时候慢慢转，像小时候那种唱片机。\n音量条右边接了一排律动条和几个快捷按钮，进度条两头标上时间，播放键挪到正中间，做成圆的。", "tags": ["视觉", "音乐"]}, {"date": "2021-12-15", "title": "歌词能分三种方式看了", "desc": "栏里一份、右下角悬浮播放器一份、页面最底下一行一份。\n三种各自能开关，想要哪个开哪个，窄屏的时候布局自己会让一让。", "tags": ["音乐", "功能"]}, {"date": "2022-02-15", "title": "给播放器加了曲目列表和播放模式", "desc": "一直只有一首歌单曲循环，听久了烦。这回加了列表，能点着切，也能上一首下一首。\n播放模式做成顺序、单曲、随机三个轮着换，选过哪个下次还记得。\n歌词默认收起来了，想看的再点开，页面清净不少。\n顺手修了个角标显示错乱的毛病——单曲循环那个小 1 和悬浮提示抢同一个位置，叠在一起了。", "tags": ["音乐", "功能"]}, {"date": "2022-03-15", "title": "歌词支持了逐字高亮", "desc": "之前整句亮，现在按时间轴一个字一个字亮，卡的歌也能跟住。LRC 里三位毫秒也认。", "tags": []}, {"date": "2022-04-15", "title": "进度条终于能拖了", "desc": "这事折腾了我一晚上。一开始以为是音频文件的问题，换了几个格式都不行。\n后来才发现跟文件没关系：托管那边返回静态资源时没带 Accept-Ranges，拖进度条发的分段请求，它一律回整个文件，浏览器就定不了位。\n最后把音频单独挪到一个支持分段请求的 CDN 上，页面还在原来的地方，地址前缀收在一处，以后换也方便。", "tags": ["音乐", "修复"]}, {"date": "2022-06-15", "title": "标签砍到七个，列表一页十二篇", "desc": "之前标签三十个，好多是只出现一次的专名，看着乱。狠狠心砍到七个：随笔、书评、前端、摘录、情感、英文、影评。\n一页五篇太少，翻页翻得烦，改成十二篇。\n改的时候还撞了个报错，筛选函数引用了一个没定义的变量，列表一打开就崩，找了一会儿才找到。", "tags": ["阅读", "整理"]}, {"date": "2022-07-15", "title": "背景图能跟着节气换了", "desc": "二十四个节气各配一张，到了日子自动换，也能手动锁一张。嫌烦就关掉，退回纯色。", "tags": []}, {"date": "2022-08-15", "title": "背景能换了，头像换成会动的", "desc": "挑了三张插画当备选，在外观设置里换，换过会记住，也可以设成每次进站随机。\n头像换成了动图，比原来那张死的有点意思。", "tags": ["视觉", "功能"]}, {"date": "2022-10-15", "title": "文章页能看「同标签」了", "desc": "读完一篇想顺着看同主题的，底部一排相关文章按标签凑，最多八篇，凑不满也不硬填。", "tags": []}, {"date": "2022-11-15", "title": "把常用的站点整理成了一张导航", "desc": "原来零零散散存了五十来个，干脆一次补全，凑到一百五十多个，分成十四类。\n每一个都在没有代理的网络下点开试过，ChatGPT、YouTube、维基这些在这边打不开的，删了十个，免得点进去一片白。\n图标也从在线服务换成本地缓存，整站图标加一起一点五兆，打开快，也不怕哪天图标服务挂了。\n分类卡片的底色压深了一点，之前背景图太亮，字有点糊。", "tags": ["导航", "内容"]}, {"date": "2022-12-15", "title": "加了 robots 和 sitemap", "desc": "想让搜索引擎收得干净点，sitemap 自动跟着文章生成，robots 把后台和工具目录挡在外面。", "tags": []}, {"date": "2023-02-15", "title": "导航的「更多」收起了冷门入口", "desc": "顶栏越来越挤，把不常点的收进下拉，鼠标移上去才展开。主区只剩主页、动态、文章、天气几个。", "tags": []}, {"date": "2023-09-15", "title": "图片改成懒加载", "desc": "文章里的图多了，首屏一下子全拉太慢。改成滚到哪张加载哪张，加载完也不撑高度，阅读位置不跳。", "tags": []}, {"date": "2023-10-15", "title": "代码块加了复制按钮", "desc": "技术文里一坨坨代码，选中再右键太麻烦。每段右上角放了个复制，点一下整段进剪贴板。", "tags": []}, {"date": "2023-12-15", "title": "日历能直接跳到发过文的日子", "desc": "右栏那个小日历，标了文的日子点一下就列出当天所有文章。空白的日子不跳，免得点进去什么都没有。", "tags": []}, {"date": "2024-01-15", "title": "首页能直接预览最新三篇", "desc": "进来不用点进文章列表，首屏就挂上最近写的，配封面和一句引子。想多看就去列表，不强迫。", "tags": []}, {"date": "2024-05-15", "title": "写了个本地草稿箱", "desc": "写到一半不想发了，先存着。草稿只在自己这台机器，不进云端，哪天想捡回来就捡。", "tags": []}, {"date": "2024-07-15", "title": "标签从七个扩回受控词表", "desc": "之前砍到七个太狠，一些跨篇的主题挂不上了。改成一份受控词表，每篇一两枚，能串起三篇以上的才留。", "tags": []}, {"date": "2024-08-15", "title": "文章能导出 PDF 了", "desc": "想打印或者存一份离线版，点一下就有。样式单独调过，代码块不换行、引用不截断，打出来跟网页一样清楚。", "tags": []}, {"date": "2024-11-15", "title": "长文记住读到哪了", "desc": "关掉页面再回来，滚动位置记住了，连目录里那一行都还是亮着的。短于三屏的不记，省得没必要。", "tags": []}, {"date": "2025-05-15", "title": "深色模式不再是反色", "desc": "之前深色就是浅色翻过来，字发虚。重做了配色，深的背景是带点紫的黑，字是暖白，看久了眼睛不累。", "tags": []}, {"date": "2025-07-15", "title": "相册能按拍摄地分组了", "desc": "照片多了以后一团乱，按城市聚成一堆，点开一座城就能翻完。没拍地的归到「未归类」，不硬猜。", "tags": []}, {"date": "2025-10-15", "title": "播放器挪到了左下角", "desc": "悬浮球原来在右下，总跟滚动条和歌词条打架。挪到左下角之后，右手划页面、左手切歌，互不挡。", "tags": []}, {"date": "2026-01-15", "title": "搜索能搜动态和相册了", "desc": "之前 Ctrl+K 只翻文章，现在动态里的一句、相册里的一张也能搜到。索引在进站时偷偷建好，第一次按下去几乎不卡。", "tags": []}, {"date": "2026-02-15", "title": "每篇文章做了分享卡片", "desc": "点开文章右上角能生成一张带标题和封面的图，发给朋友不用再截图。底色跟着分类走，技术文是冷的蓝，书评是暖的橙。", "tags": []}, {"date": "2026-03-15", "title": "内页地址换成了真路径", "desc": "以前点进任何一个内页，地址栏最后都会变成 index.html#/writing 这一段，复制分享出去也是它。\n现在就是 /writing、/post?id=xxx。刷新、收藏、右键新窗口打开，拿到的都是这个；老书签 /#/writing 照样能用，带 .html 的老地址也会 308 一次落到新地址。\n改的时候踩了两个坑：导航高亮原来按子串比对，首页那个「/」是任何地址的子串，于是每一页都把「主页」点亮；还有「来源页」靠 hash 认首页，根路径没有 hash 就认不出来，返回会掉回文章列表。两个都补上了。", "tags": ["改版", "路由"]}, {"date": "2026-05-15", "title": "目录浮起来了", "desc": "长文的目录原来长在右边一列，读到下半篇就滑出视野，回头找一节还得往上滚。\n现在它是个浮在旁边的小标签，默认收着，点开是一张能自己滚的列表。拖到顺手的位置，下次还记得那个位置。", "tags": ["改版", "目录"]}, {"date": "2026-07-15", "title": "右栏的动态能点了", "desc": "以前右栏那四条只有摘要，想知道是哪篇得自己去文章列表里翻。现在点哪条进哪篇。", "tags": ["改版"]}], "splash": {"bg": "assets/uploads/bg.jpg", "video": "", "hi": "", "title": "RezeのBlog", "lines": ["凡是过往，皆为序章。", "夜里也有花开。", "漫漫长路锤炼身躯，幽幽魂灵雕琢心智。", "慢一点也没关系，风会等愿意停的人。", "月亮不说话，却照了很多人的夜路。", "把日子过成自己喜欢的样子，就够了。", "今天也想做一个温柔的人。", "没什么大不了，明天太阳照常升起。", "允许自己偶尔什么都不想做。", "安静地喜欢，也是一种浪漫。", "把心事说给风，风会替你保管。", "世界很大，慢慢走，慢慢看。", "故事还在写，先不剧透结局。", "我们终将相遇，在更好的自己里。", "你不必发光，温暖就够了。", "落花人独立，微雨燕双飞。", "晚来天欲雪，能饮一杯无。", "人生有味是清欢。", "当时明月在，曾照彩云归。", "春水碧于天，画船听雨眠。", "山中何事，松花酿酒，春水煎茶。", "我见过最美的烟火，是在平凡的夜里。", "把遗憾折成纸船，放它漂走吧。", "Stay hungry, stay foolish.", "The best is yet to come.", "All we have is now.", "人は皆、星になれる。", "また会える日まで。", "光さす方へ。", "君がくれた夏。", "Petit à petit, l'oiseau fait son nid.", "La vie est belle.", "Der Weg ist das Ziel.", "Eppur si muove."], "quote": "", "quoteFrom": "", "scrollText": "向下滑动"}, "poems": [{"t": "少年不识愁滋味，爱上层楼。爱上层楼，为赋新词强说愁。\n而今识尽愁滋味，欲说还休。欲说还休，却道天凉好个秋。", "by": "宋·辛弃疾《丑奴儿·书博山道中壁》"}, {"t": "一片春愁待酒浇。江上舟摇，楼上帘招。秋娘渡与泰娘桥，风又飘飘，雨又萧萧。\n何日归家洗客袍？银字笙调，心字香烧。流光容易把人抛，红了樱桃，绿了芭蕉。", "by": "宋·蒋捷《一剪梅·舟过吴江》"}, {"t": "君问归期未有期，巴山夜雨涨秋池。\n何当共剪西窗烛，却话巴山夜雨时。", "by": "唐·李商隐《夜雨寄北》"}, {"t": "独坐幽篁里，弹琴复长啸。\n深林人不知，明月来相照。", "by": "唐·王维《竹里馆》"}, {"t": "风乍起，吹皱一池春水。闲引鸳鸯香径里，手挼红杏蕊。\n斗鸭阑干独倚，碧玉搔头斜坠。终日望君君不至，举头闻鹊喜。", "by": "五代·冯延巳《谒金门·风乍起》"}, {"t": "一曲新词酒一杯，去年天气旧亭台。夕阳西下几时回？\n无可奈何花落去，似曾相识燕归来。小园香径独徘徊。", "by": "宋·晏殊《浣溪沙·一曲新词酒一杯》"}, {"t": "人生若只如初见，何事秋风悲画扇。等闲变却故人心，却道故人心易变。\n骊山语罢清宵半，泪雨霖铃终不怨。何如薄幸锦衣郎，比翼连枝当日愿。", "by": "清·纳兰性德《木兰花·拟古决绝词柬友》"}, {"t": "莫听穿林打叶声，何妨吟啸且徐行。竹杖芒鞋轻胜马，谁怕？一蓑烟雨任平生。\n料峭春风吹酒醒，微冷，山头斜照却相迎。回首向来萧瑟处，归去，也无风雨也无晴。", "by": "宋·苏轼《定风波·莫听穿林打叶声》"}, {"t": "春花秋月何时了，往事知多少。小楼昨夜又东风，故国不堪回首月明中。\n雕栏玉砌应犹在，只是朱颜改。问君能有几多愁，恰似一江春水向东流。", "by": "南唐·李煜《虞美人·春花秋月何时了》"}, {"t": "枯藤老树昏鸦，小桥流水人家，古道西风瘦马。\n夕阳西下，断肠人在天涯。", "by": "元·马致远《天净沙·秋思》"}, {"t": "人人尽说江南好，游人只合江南老。春水碧于天，画船听雨眠。\n垆边人似月，皓腕凝霜雪。未老莫还乡，还乡须断肠。", "by": "唐·韦庄《菩萨蛮·人人尽说江南好》"}]}}