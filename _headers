# Cloudflare Pages 响应头
# 只做两件事：补几个安全头，给带版本号的静态资源开长缓存。
# 页面只引 Microsoft Clarity 一个第三方统计脚本，不加载其它外部库；未启用 CSP。

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()

# HTML 不做长缓存，改一次就立刻生效
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# 后台、构建脚本和逐篇源文件会随仓库一起部署（Pages 部署整个仓库，没有排除目录的开关），
# 代码里不含口令，只是不该被搜索引擎收进去
/tools/*
  X-Robots-Tag: noindex

/content/*
  X-Robots-Tag: noindex

/admin.html
  X-Robots-Tag: noindex, nofollow

# 下面这些文件都带 ?v= 版本号，改文件必然换地址，可以放心 immutable
# 字体不走 ?v=，改用内容哈希文件名；同理，改字库就必须换文件名
/assets/css/*
  Cache-Control: public, max-age=31536000, immutable

/assets/js/*
  Cache-Control: public, max-age=31536000, immutable

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/icons/*
  Cache-Control: public, max-age=31536000, immutable

# 音频和图片按文件名访问，换文件可能不换名，缓存给短一点
/assets/audio/*
  Cache-Control: public, max-age=604800

/assets/uploads/*
  Cache-Control: public, max-age=604800

# 剧情全集是独立静态页：外壳跟着改，分节文件按需取、给一周缓存
/gf-story*
  Cache-Control: public, max-age=0, must-revalidate

/gf-story/parts/*
  Cache-Control: public, max-age=604800
