# 系统文件
Thumbs.db
.DS_Store

# 编辑器
.vscode/
.idea/

# 临时文件
_t*.html
*.log
__pycache__/
*.pyc

# 只在本地用、不随站点发布的东西（原始书籍、备份、临时 JSON、完整字体等）
# Cloudflare Pages 部署的是整个仓库，所以「不进 git」就等于「不上线」。
_local/

# 改写文案用的辅助文件（不上线）
_rewrite.py
_cloud_patch.json
cloud_content_*.json
docx_fulltext.txt

# 截图用的调试脚本（本地工具，不发布）
_cdp.js
_probe.js
_act.js

# 临时工具目录（不上线）
.tmp_site/

# 本地临时抓取/截图用的目录（不该进仓，也不该上线）
.tmp/

# 口令与本地凭据禁止入库（历史里曾误提交 _push_cloud.py 到 public 仓库）
_push_cloud.py
*.dev.vars
.env
.env.*
**/admin_pass.txt
